# ============================================================
# PKOS v2 — Backend Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ----- Security (REQUIRED) ----------------------------------
# Generate a strong random key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If this is missing, a random key is used and all tokens reset on every restart.
PKOS_SECRET_KEY=replace-with-your-generated-secret-key

# ----- PostgreSQL -------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pkos_v2
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ----- AI models ---------------------------------------------
# Ollama is the default for every user until they choose another provider in Settings.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Default cloud models when a user picks OpenAI/Anthropic without naming a model (optional):
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-haiku-5-5
# Users' cloud API keys are encrypted in the database with a key derived from PKOS_SECRET_KEY.
# Set PKOS_SETTINGS_KEY to use a separate secret (changing either makes saved keys unreadable).
# PKOS_SETTINGS_KEY=

# ----- Embedding model (optional, defaults shown) ------------
# PKOS_EMBED_MODEL=BAAI/bge-small-en-v1.5   # or a local folder (the desktop app bundles one)
# PKOS_EMBED_CACHE_DIR=                     # Hugging Face cache folder
# PKOS_EMBED_WARMUP=true                    # load the model in the background right after startup

# ----- Graph RAG Tuning (optional, defaults shown) ----------
# GRAPH_LOCAL_EXPANSION=true
# GRAPH_GLOBAL_SEARCH=true
# GRAPH_SEEDS=5
# GRAPH_MAX_EDGES=20
# GRAPH_EXTRA_CHUNKS=2
# GRAPH_SEED_MAX_DISTANCE=0.35
# GRAPH_CHUNK_MAX_DISTANCE=0.45
# CONTEXT_MAX_CHARS=6000
# GRAPH_CONTEXT_MAX_CHARS=1800
# GRAPH_COMMUNITIES=3
# COMMUNITY_MAX_DISTANCE=0.5
# COMMUNITY_MIN_MEMBERS=10
# COMMUNITY_STRONG_DISTANCE=0.36

# ----- Conversation memory (optional, defaults shown; docs/07_MEMORY_PLAN.md) -----
# MEMORY_ENABLED=true          # false: no history, no follow-up rewriting, no running summary
# HISTORY_MAX_TURNS=6          # recent turns sent with a follow-up
# HISTORY_MAX_CHARS=2400
# SUMMARY_MAX_CHARS=1200       # running summary of older turns
# REWRITE_TIMEOUT=20           # seconds before a follow-up is searched as typed
# Long-term memory (each user also switches it on/off in Settings > Memory):
# MEMORY_MAX_PREFERENCES=5     # "how to answer" memories, always included
# MEMORY_MAX_FACTS=3           # facts/conclusions closest to the question
# MEMORY_MAX_DISTANCE=0.40     # cosine cutoff for facts (tuned by eval_memories.py)
# MEMORY_MAX_CHARS=600
# PAST_CHATS_MAX=1             # earlier chats given to a "what did we decide last time?" question
# PAST_CHATS_MAX_DISTANCE=0.45 # tuned by eval_past_chats.py

# ----- App (optional, defaults shown) -----------------------
# CORS_ORIGINS=http://localhost:3000        # comma-separated
# TOKEN_TTL_MINUTES=43200                   # 30 days
# ENV=dev                                   # "prod" or "desktop" make startup fail without PKOS_SECRET_KEY
# PKOS_DATA_DIR=                            # desktop app data folder; enables logs/api.log
